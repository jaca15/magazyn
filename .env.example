# Skopiuj ten plik jako .env i uzupełnij wartości dla swojego środowiska.
# Plik .env jest wykluczony z repozytorium (.gitignore).

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=magazyn_sprzetu
DB_USER=root
DB_PASSWORD=change_me_in_production
DB_CHARSET=utf8mb4

# APP_ENV: "production" lub "development"
# W trybie development błędy połączenia z BD są wyświetlane — NIE używaj w produkcji.
APP_ENV=production
